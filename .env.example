# Ключ Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Необязательно: модель для отчётов
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 = отдавать заготовленный отчёт без вызова AI (для работы над интерфейсом)
MOCK_REPORT=0
# Supabase (кэш отчётов и лимит запросов). Без них всё работает в памяти сервера.
# Ключ: Project Settings → API Keys → Secret key (sb_secret_...). Только на сервере!
SUPABASE_URL=
SUPABASE_SECRET_KEY=
